{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WSX rootfs manifest v1",
  "type": "object",
  "required": [
    "distribution_id",
    "image_version",
    "upstream_release",
    "upstream_commit",
    "architecture",
    "archive_format",
    "asset_name",
    "sha256",
    "build_identity",
    "build_commit",
    "schema_version",
    "wsx_revision",
    "compressed_size",
    "unpacked_size",
    "installation_space_required",
    "guest_interface_abi",
    "minimum_wsx_core_version",
    "graphics_components",
    "kernel_requirements",
    "validation"
  ],
  "properties": {
    "distribution_id": {
      "enum": [
        "wsx-omarchy",
        "wsx-cachyos-plasma"
      ]
    },
    "image_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)-r[1-9][0-9]*$"
    },
    "upstream_release": {
      "type": "string",
      "minLength": 1
    },
    "upstream_commit": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{40}$"
    },
    "architecture": {
      "const": "x86_64"
    },
    "archive_format": {
      "const": "tar.zst"
    },
    "asset_name": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$"
    },
    "build_identity": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$"
    },
    "build_commit": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{40}$"
    },
    "schema_version": {
      "const": 1
    },
    "wsx_revision": {
      "type": "integer",
      "minimum": 1
    },
    "compressed_size": {
      "type": "integer",
      "minimum": 1
    },
    "unpacked_size": {
      "type": "integer",
      "minimum": 1
    },
    "installation_space_required": {
      "type": "integer",
      "minimum": 1
    },
    "guest_interface_abi": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "minimum_wsx_core_version": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "graphics_components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "version",
          "inputs_sha256"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "inputs_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "kernel_requirements": {
      "type": "object",
      "minProperties": 1
    },
    "validation": {
      "type": "object",
      "required": [
        "build",
        "offline",
        "wsl_boot",
        "gpu_first_frame",
        "desktop",
        "stability"
      ],
      "properties": {
        "build": {
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        },
        "offline": {
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        },
        "wsl_boot": {
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        },
        "gpu_first_frame": {
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        },
        "desktop": {
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        },
        "stability": {
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        }
      },
      "additionalProperties": false
    },
    "cpu_requirements": {
      "type": "object",
      "required": [
        "architecture_level"
      ],
      "properties": {
        "architecture_level": {
          "enum": [
            "x86-64-v3"
          ]
        }
      },
      "additionalProperties": false
    },
    "source_delivery_schema": {
      "type": "integer",
      "enum": [
        1,
        2
      ],
      "description": "1: bundled component sources; 2: image recipe, public shared graphics source index and exact component receipt."
    },
    "desktop_compatibility": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "lifecycle_abi": {
          "const": 1
        },
        "display_abi": {
          "const": 1
        },
        "sharing_path": {
          "const": "opaque-v1"
        },
        "producer_abi": {
          "const": 1
        },
        "consumer_abi": {
          "const": 2
        },
        "retirement": {
          "const": "guest-stop-v1"
        },
        "guest_protocol_major": {
          "const": 1
        },
        "guest_protocol_minor": {
          "const": 0
        },
        "runtime_receipt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "guest_profile_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "required_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "schema_version",
        "lifecycle_abi",
        "display_abi",
        "sharing_path",
        "producer_abi",
        "consumer_abi",
        "retirement",
        "guest_protocol_major",
        "guest_protocol_minor",
        "runtime_receipt_sha256",
        "guest_profile_sha256",
        "required_capabilities"
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
