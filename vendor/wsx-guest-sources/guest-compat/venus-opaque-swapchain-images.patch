+         bool has_storage = false;
+         for (uint32_t i = 0; i < list->viewFormatCount; i++)
+            has_storage |= list->pViewFormats[i] == storage_format;
+         if (!has_storage) {
+            const uint32_t count = list->viewFormatCount ? list->viewFormatCount + 1 : 2;
+            VkFormat *formats = vk_alloc(&chain->alloc, count * sizeof(*formats),
+                                         8, VK_SYSTEM_ALLOCATION_SCOPE_OBJECT);
+            if (!formats) {
+               wsi_destroy_image_info(chain, info);
+               return VK_ERROR_OUT_OF_HOST_MEMORY;
+            }
+            formats[0] = storage_format;
+            if (list->viewFormatCount) {
+               memcpy(formats + 1, list->pViewFormats,
+                      list->viewFormatCount * sizeof(*formats));
+               vk_free(&chain->alloc, (void *)list->pViewFormats);
+            } else {
+               formats[1] = surface_format;
+               list->sType = VK_STRUCTURE_TYPE_IMAGE_FORMAT_LIST_CREATE_INFO;
+               __vk_append_struct(&info->create, list);
+            }
+            list->pViewFormats = formats;
+            list->viewFormatCount = count;
+         }
+         info->create.format = storage_format;
+         info->create.flags |= VK_IMAGE_CREATE_MUTABLE_FORMAT_BIT;
+      }
       const VkImageCreateInfo *ci = &info->create;
