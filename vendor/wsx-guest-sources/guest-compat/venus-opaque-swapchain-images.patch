+      info->create.usage |= consumer_usage;
+      info->usage2.usage |= consumer_usage;
+      /* The opaque descriptor carries the UNORM storage format. Vulkan
+       * clients can render to a compatible sRGB view of that same storage. */
+      const VkFormat surface_format = info->create.format;
+      VkFormat storage_format = surface_format;
+      if (surface_format == VK_FORMAT_B8G8R8A8_SRGB)
+         storage_format = VK_FORMAT_B8G8R8A8_UNORM;
+      else if (surface_format == VK_FORMAT_R8G8B8A8_SRGB)
+         storage_format = VK_FORMAT_R8G8B8A8_UNORM;
