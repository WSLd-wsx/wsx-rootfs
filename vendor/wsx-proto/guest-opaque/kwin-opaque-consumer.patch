+EGLImageKHR EglDisplay::importWsxNativePixmap(void *nativeBo) const
+{
+    auto bo = static_cast<gbm_bo *>(nativeBo);
+    if (!bo || !m_drmDevice || gbm_bo_get_device(bo) != m_drmDevice->gbmDevice()
+        || !m_extensions.contains(QByteArrayLiteral("EGL_KHR_image_pixmap"))) {
+        return EGL_NO_IMAGE_KHR;
+    }
+    // Mesa GBM duplicates the original DRI image reference, preserving VkImage
+    // identity. It does not import the fd into a second image or copy pixels.
+    const EGLint attribs[] = {EGL_IMAGE_PRESERVED_KHR, EGL_TRUE, EGL_NONE};
+    auto image = createImage(EGL_NO_CONTEXT, EGL_NATIVE_PIXMAP_KHR, bo, attribs);
+    qInfo() << "WSX_OPAQUE_NATIVE_PIXMAP" << (image != EGL_NO_IMAGE_KHR);
+    return image;
+}
