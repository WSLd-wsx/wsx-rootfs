+// The private manager only constructs ordinary wl_buffers after kernel lookup.
+// Existing buffer references and synchronization own the fd until retirement.
+void CLinuxDMABufV1Protocol::bindOpaque(wl_client* client, void* data, uint32_t, uint32_t id) {
+    auto* self = static_cast<CLinuxDMABufV1Protocol*>(data);
+    auto* resource = wl_resource_create(client, &wsx_opaque_buffer_manager_v1_interface, 1, id);
+    if (!resource) { wl_client_post_no_memory(client); return; }
+    static const struct wsx_opaque_buffer_manager_v1_interface implementation = {
+        .destroy = [](wl_client*, wl_resource* r) { wl_resource_destroy(r); },
+        .create_buffer = [](wl_client* c, wl_resource* r, uint32_t id, int fd, uint32_t w, uint32_t h, uint32_t f) {
+            static_cast<CLinuxDMABufV1Protocol*>(wl_resource_get_user_data(r))->createOpaque(c, r, id, fd, w, h, f);
+        },
+    };
+    self->m_opaqueManagers.push_back(resource);
+    wl_resource_set_implementation(resource, &implementation, self, [](wl_resource* r) {
+        auto* self = static_cast<CLinuxDMABufV1Protocol*>(wl_resource_get_user_data(r));
+        std::erase(self->m_opaqueManagers, r);
+    });
+}
+
+void CLinuxDMABufV1Protocol::createOpaque(wl_client* client, wl_resource* manager, uint32_t id,
+                                         int fd, uint32_t width, uint32_t height, uint32_t format) {
+    CFileDescriptor owned{fd};
+    drm_wsx_opaque_query query{};
+    uint32_t vkFormat = format == DRM_FORMAT_ARGB8888 || format == DRM_FORMAT_XRGB8888 ? 44 :
+        format == DRM_FORMAT_ABGR8888 || format == DRM_FORMAT_XBGR8888 ? 37 : 0;
+    if (!Render::GL::g_pHyprOpenGL->wsxOpaqueSupported() || !vkFormat ||
+        wsx_gbm_lookup_opaque_fd(m_mainDeviceFD.get(), fd, width, height, vkFormat, &query)) {
+        wl_resource_post_error(manager, WSX_OPAQUE_BUFFER_MANAGER_V1_ERROR_INVALID_DESCRIPTOR,
+                               "WSX opaque PRIME descriptor rejected");
+        return;
+    }
+    Aquamarine::SDMABUFAttrs attrs{};
+    attrs.success = true; attrs.planes = 1; attrs.size = Vector2D{static_cast<double>(width), static_cast<double>(height)};
+    attrs.format = format; attrs.modifier = DRM_FORMAT_MOD_INVALID;
+    attrs.fds.fill(-1); attrs.fds[0] = owned.take();
+    attrs.strides.fill(0); attrs.offsets.fill(0);
+    auto buffer = makeUnique<CLinuxDMABuffer>(id, client, attrs);
+    if (!buffer->good()) {
+        wl_resource_post_error(manager, WSX_OPAQUE_BUFFER_MANAGER_V1_ERROR_INVALID_DESCRIPTOR,
+                               "WSX opaque EGL import rejected");
+        return;
+    }
+    m_buffers.push_back(std::move(buffer));
+}
+
+CLinuxDMABufV1Protocol::~CLinuxDMABufV1Protocol() {
+    if (m_opaqueGlobal) wl_global_destroy(m_opaqueGlobal);
+    while (!m_opaqueManagers.empty()) wl_resource_destroy(m_opaqueManagers.back());
+}
