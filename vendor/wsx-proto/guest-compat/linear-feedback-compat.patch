+/* Restrict optional feedback optimizations only after an exact external-image
+ * query proves that the shared linear color profile cannot support them.
+ * Never promote a conditional format feature or enable a copy fallback.
+ */
+static void
+wsx_negotiate_linear_feedback(struct zink_screen *screen)
+{
+   if (!debug_get_bool_option("WSX_ZINK_LINEAR_FEEDBACK_COMPAT", false) ||
+       !screen->info.have_NV_linear_color_attachment ||
+       !screen->info.linear_color_feats.linearColorAttachment ||
+       !screen->info.have_EXT_image_drm_format_modifier ||
+       !screen->info.have_EXT_external_memory_dma_buf)
+      return;
+   const VkFormat formats[] = {VK_FORMAT_B8G8R8A8_UNORM, VK_FORMAT_R8G8B8A8_UNORM};
+   bool restricted = false;
+   for (unsigned i = 0; i < ARRAY_SIZE(formats); i++) {
+      VkPhysicalDeviceImageDrmFormatModifierInfoEXT modifier = {
+         .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_IMAGE_DRM_FORMAT_MODIFIER_INFO_EXT,
+         .drmFormatModifier = DRM_FORMAT_MOD_LINEAR,
+         .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+      };
+      VkPhysicalDeviceExternalImageFormatInfo external = {
+         .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_EXTERNAL_IMAGE_FORMAT_INFO,
+         .pNext = &modifier,
+         .handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+      };
+      VkPhysicalDeviceImageFormatInfo2 query = {
+         .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_IMAGE_FORMAT_INFO_2,
+         .pNext = &external, .format = formats[i], .type = VK_IMAGE_TYPE_2D,
+         .tiling = VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT,
+         .usage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_SAMPLED_BIT |
+                  VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT,
+      };
+      VkExternalImageFormatProperties external_props = {
+         .sType = VK_STRUCTURE_TYPE_EXTERNAL_IMAGE_FORMAT_PROPERTIES,
+      };
+      VkImageFormatProperties2 props = {
+         .sType = VK_STRUCTURE_TYPE_IMAGE_FORMAT_PROPERTIES_2, .pNext = &external_props,
+      };
+      VkResult basic = VKSCR(GetPhysicalDeviceImageFormatProperties2)(screen->pdev, &query, &props);
+      const VkExternalMemoryFeatureFlags required = VK_EXTERNAL_MEMORY_FEATURE_EXPORTABLE_BIT | VK_EXTERNAL_MEMORY_FEATURE_IMPORTABLE_BIT;
+      if (basic != VK_SUCCESS || (external_props.externalMemoryProperties.externalMemoryFeatures & required) != required)
+         return;
+      query.usage |= VK_IMAGE_USAGE_INPUT_ATTACHMENT_BIT | VK_IMAGE_USAGE_ATTACHMENT_FEEDBACK_LOOP_BIT_EXT;
+      VkResult feedback = VKSCR(GetPhysicalDeviceImageFormatProperties2)(screen->pdev, &query, &props);
+      if (feedback != VK_SUCCESS && feedback != VK_ERROR_FORMAT_NOT_SUPPORTED)
+         return;
+      restricted |= feedback == VK_ERROR_FORMAT_NOT_SUPPORTED;
+      mesa_logi("WSX_LINEAR_FEEDBACK: format=%u basic=%d feedback=%d", formats[i], basic, feedback);
+   }
+   if (!restricted)
+      return;
+   /* Existing Zink GENERAL-layout and non-fbfetch paths remain responsible for
+    * execution. Do not advertise framebuffer-fetch support to Gallium clients.
+    */
+   screen->info.have_EXT_attachment_feedback_loop_layout = false;
+   screen->info.have_EXT_attachment_feedback_loop_dynamic_state = false;
+   screen->info.have_KHR_dynamic_rendering_local_read = false;
+}
+
 static void
 init_driver_workarounds(struct zink_screen *screen)
 {
+   wsx_negotiate_linear_feedback(screen);
    /* enable implicit sync for all non-mesa drivers */
    screen->driver_workarounds.implicit_sync = !zink_driver_is_venus(screen);
    switch (zink_driverid(screen)) {
