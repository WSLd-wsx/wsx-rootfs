+/* WSX descriptor transport carries opaque images, not implicit DMA-BUF layouts.
+ * Use the renderer's actual DRM node and paired ABI before querying the Host.
+ * The native external-image query remains authoritative for all image flags. */
+static bool
+wsx_opaque_query_transport(struct vn_physical_device *physical_dev)
+{
+   const char *profile = getenv("WSX_VENUS_DIRECT_WSI");
+   if (!profile || strcmp(profile, "opaque-v1"))
+      return false;
+   const VkPhysicalDeviceDrmPropertiesEXT *drm =
+      &physical_dev->instance->renderer->info.drm.props;
+   if (!drm->hasRender)
+      return false;
+   char path[64];
+   snprintf(path, sizeof(path), "/dev/dri/renderD%lld", (long long)drm->renderMinor);
+   int fd = open(path, O_RDWR | O_CLOEXEC);
+   if (fd < 0)
+      return false;
+   struct stat st;
+   bool supported = !fstat(fd, &st) && S_ISCHR(st.st_mode) &&
+      major(st.st_rdev) == drm->renderMajor && minor(st.st_rdev) == drm->renderMinor &&
+      wsx_gbm_opaque_consumer_supported(fd) == 1;
+   close(fd);
+   return supported;
+}
+
 
