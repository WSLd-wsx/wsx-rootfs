+static int
+wsx_wsi_render_fd(const struct wsi_device *wsi)
+{
+   if (!wsi->drm_info.hasRender) return -1;
+   char path[64];
+   snprintf(path, sizeof(path), "/dev/dri/renderD%lld", (long long)wsi->drm_info.renderMinor);
+   int fd = open(path, O_RDWR | O_CLOEXEC);
+   if (fd < 0) return -1;
+   struct stat st;
+   if (fstat(fd, &st) || !S_ISCHR(st.st_mode) ||
+       major(st.st_rdev) != wsi->drm_info.renderMajor || minor(st.st_rdev) != wsi->drm_info.renderMinor ||
+       wsx_gbm_opaque_consumer_supported(fd) != 1) {
+      close(fd); return -1;
+   }
+   return fd;
+}
