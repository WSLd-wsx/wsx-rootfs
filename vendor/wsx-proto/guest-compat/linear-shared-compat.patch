+static bool
+wsx_linear_framebuffer_valid(struct zink_context *ctx)
+{
+   struct zink_screen *screen = zink_screen(ctx->base.screen);
+   if (!screen->wsx_linear_shared)
+      return true;
+   bool conditional = false;
+   for (unsigned i = 0; i < ctx->fb_state.nr_cbufs; i++) {
+      struct pipe_resource *tex = ctx->fb_state.cbufs[i].texture;
+      conditional |= tex && zink_resource(tex)->obj->wsx_conditional_linear_color;
+   }
+   if (!conditional)
+      return true;
+   for (unsigned i = 0; i < ctx->fb_state.nr_cbufs; i++) {
+      const struct pipe_surface *surf = &ctx->fb_state.cbufs[i];
+      if (!surf->texture)
+         continue;
+      struct zink_resource *res = zink_resource(surf->texture);
+      const struct zink_format_props *props = zink_get_format_props(screen, surf->format);
+      if ((!res->linear && res->obj->modifier != 0) || surf->nr_samples || res->transient ||
+          !(props->linearTilingFeatures & VK_FORMAT_FEATURE_2_LINEAR_COLOR_ATTACHMENT_BIT_NV)) {
+         mesa_loge("WSX_LINEAR_FRAMEBUFFER: rejected incompatible color attachment %u", i);
+         return false;
+      }
+   }
+   return true;
+}
