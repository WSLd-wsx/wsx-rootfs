+/* WSX adapter: opt-in alone is insufficient. The paired kernel/Host must
+ * negotiate descriptor support and Vulkan must admit this exact image. */
+static bool
+wsx_opaque_export_supported(struct zink_screen *screen, const VkImageCreateInfo *ici,
+                            VkExternalMemoryHandleTypeFlags handles)
+{
+#if defined(HAVE_LIBDRM) && !defined(_WIN32)
+   if (wsx_gbm_opaque_supported(screen->drm_fd) != 1)
+      return false;
+   if (!screen->info.have_KHR_dedicated_allocation ||
+       !VKSCR(GetPhysicalDeviceImageFormatProperties2) ||
+       ici->imageType != VK_IMAGE_TYPE_2D || ici->extent.depth != 1 ||
+       ici->mipLevels != 1 || ici->arrayLayers != 1 || ici->samples != VK_SAMPLE_COUNT_1_BIT ||
+       (ici->format != VK_FORMAT_B8G8R8A8_UNORM && ici->format != VK_FORMAT_R8G8B8A8_UNORM) ||
+       ici->sharingMode != VK_SHARING_MODE_EXCLUSIVE ||
+       (ici->flags & (VK_IMAGE_CREATE_SPARSE_BINDING_BIT | VK_IMAGE_CREATE_DISJOINT_BIT)))
+      return false;
+   const VkExternalMemoryHandleTypeFlags allowed = VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_FD_BIT |
+      VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT;
+   if (!(handles & VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT) || (handles & ~allowed))
+      return false;
+   for (unsigned bit = 0; bit < 32; bit++) {
+      VkExternalMemoryHandleTypeFlagBits handle = 1u << bit;
+      if (!(handles & handle)) continue;
+      VkPhysicalDeviceExternalImageFormatInfo external = {
+         .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_EXTERNAL_IMAGE_FORMAT_INFO,
+         .pNext = ici->pNext, .handleType = handle,
+      };
+      VkPhysicalDeviceImageFormatInfo2 info = {
+         .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_IMAGE_FORMAT_INFO_2,
+         .pNext = &external, .format = ici->format, .type = ici->imageType,
+         .tiling = ici->tiling, .usage = ici->usage, .flags = ici->flags,
+      };
+      VkExternalImageFormatProperties external_props = {
+         .sType = VK_STRUCTURE_TYPE_EXTERNAL_IMAGE_FORMAT_PROPERTIES,
+      };
+      VkImageFormatProperties2 props = {
+         .sType = VK_STRUCTURE_TYPE_IMAGE_FORMAT_PROPERTIES_2, .pNext = &external_props,
+      };
+      VkResult result = VKSCR(GetPhysicalDeviceImageFormatProperties2)(screen->pdev, &info, &props);
+      const VkExternalMemoryProperties *caps = &external_props.externalMemoryProperties;
+      const VkExternalMemoryFeatureFlags required = VK_EXTERNAL_MEMORY_FEATURE_EXPORTABLE_BIT |
+         VK_EXTERNAL_MEMORY_FEATURE_IMPORTABLE_BIT;
+      bool accepted = result == VK_SUCCESS && (caps->externalMemoryFeatures & required) == required &&
+         (caps->compatibleHandleTypes & handles) == handles &&
+         ici->extent.width <= props.imageFormatProperties.maxExtent.width &&
+         ici->extent.height <= props.imageFormatProperties.maxExtent.height &&
+         (props.imageFormatProperties.sampleCounts & ici->samples);
+      mesa_logi("WSX_OPAQUE_EXPORT_QUERY: format=%u extent=%ux%u tiling=%u usage=%x flags=%x handle=%x result=%d features=%x compatible=%x accepted=%u",
+         ici->format, ici->extent.width, ici->extent.height, ici->tiling, ici->usage, ici->flags,
+         handle, result, caps->externalMemoryFeatures, caps->compatibleHandleTypes, accepted);
+      if (!accepted) return false;
+   }
+   return true;
+#else
+   return false;
+#endif
+}
