@@ -3056,6 +3058,40 @@
 
 static bool wsx_linear_framebuffer_valid(struct zink_context *ctx);
 
+/* An existing swapchain image cannot change tiling in place. Until the
+ * opaque-optimal WSI/KMS/Owner contract exists, report a local context failure
+ * rather than dropping depth, copying, or submitting a known unsafe combination.
+ */
+static bool
+wsx_linear_depth_valid(struct zink_context *ctx)
+{
+   struct zink_screen *screen = zink_screen(ctx->base.screen);
+   const VkRenderingInfo *info = &ctx->dynamic_fb.info;
+   bool depth = info->pDepthAttachment && info->pDepthAttachment->imageView;
+   bool stencil = info->pStencilAttachment && info->pStencilAttachment->imageView;
+   if (!screen->wsx_linear_shared || (!depth && !stencil))
+      return true;
+   for (unsigned i = 0; i < ctx->fb_state.nr_cbufs; i++) {
+      const struct pipe_surface *surf = &ctx->fb_state.cbufs[i];
+      if (!surf->texture || i >= info->colorAttachmentCount ||
+          !info->pColorAttachments[i].imageView)
+         continue;
+      struct zink_resource *res = zink_resource(surf->texture);
+      const struct zink_format_props *props = zink_get_format_props(screen, surf->format);
+      if (!zink_wsx_requires_optimal_color(screen->wsx_linear_shared,
+             res->linear || res->obj->modifier == 0, props->linearTilingFeatures,
+             depth, stencil))
+         continue;
+      mesa_loge("WSX_LAYOUT_REJECT: context=%p color=%u format=%u extent=%ux%u depth=%u stencil=%u required=optimal opaque_present=unavailable action=context-reset staging=0",
+                (void *)ctx, i, zink_get_format(screen, surf->format),
+                info->renderArea.extent.width, info->renderArea.extent.height,
+                depth, stencil);
+      ctx->wsx_layout_failed = true;
+      return false;
+   }
+   return true;
+}
