+/* SPDX-License-Identifier: MIT */
+#ifndef ZINK_WSX_LAYOUT_H
+#define ZINK_WSX_LAYOUT_H
+
+#include <stdbool.h>
+#include <vulkan/vulkan.h>
+
+/* A WSX adapter policy for the negotiated conditional-linear profile, not a
+ * Vulkan-wide restriction. Unconditional linear attachment support is unchanged.
+ * The caller must use the actual acquired image and actual attachment views.
+ */
+static inline bool
+zink_wsx_requires_optimal_color(bool negotiated, bool linear,
+                               VkFormatFeatureFlags2 features,
+                               bool depth_view, bool stencil_view)
+{
+   return negotiated && linear && (depth_view || stencil_view) &&
+          !(features & VK_FORMAT_FEATURE_2_COLOR_ATTACHMENT_BIT) &&
+          (features & VK_FORMAT_FEATURE_2_LINEAR_COLOR_ATTACHMENT_BIT_NV);
+}
+
+static inline bool
+zink_wsx_reject_depth_linear(bool negotiated, bool linear,
+                            VkImageUsageFlags usage)
+{
+   return negotiated && linear &&
+          (usage & VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT);
+}
+
+#endif
