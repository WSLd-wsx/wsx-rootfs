+/* Diagnose actual attachments after Kopper acquisition. This does not
+ * reinterpret a depth layout or change the negotiated sharing contract. */
+static void
+wsx_trace_linear_rendering(struct zink_context *ctx)
+{
+   struct zink_screen *screen = zink_screen(ctx->base.screen);
+   if (!screen->wsx_linear_shared ||
+       !debug_get_bool_option("WSX_ZINK_NEGOTIATE_EXPORT", false))
+      return;
+   bool conditional = false;
+   for (unsigned i = 0; i < ctx->fb_state.nr_cbufs; i++) {
+      struct pipe_resource *tex = ctx->fb_state.cbufs[i].texture;
+      conditional |= tex && zink_resource(tex)->obj->wsx_conditional_linear_color;
+   }
+   if (!conditional)
+      return;
+   const VkRenderingInfo *info = &ctx->dynamic_fb.info;
+   unsigned has_zs = !!(info->pDepthAttachment || info->pStencilAttachment);
+   if (ctx->wsx_render_trace_count[has_zs] >= 16)
+      return;
+   unsigned sequence = ++ctx->wsx_render_trace_count[has_zs];
+   mesa_logi("WSX_LINEAR_RENDERING: context=%p sequence=%u extent=%ux%u colors=%u depth=%u stencil=%u zs_used=%u",
+             (void *)ctx, sequence, info->renderArea.extent.width,
+             info->renderArea.extent.height, info->colorAttachmentCount,
+             !!info->pDepthAttachment, !!info->pStencilAttachment, !ctx->zsbuf_unused);
+   for (unsigned i = 0; i <= PIPE_MAX_COLOR_BUFS; i++) {
+      const struct pipe_surface *surf = i == PIPE_MAX_COLOR_BUFS ?
+         &ctx->fb_state.zsbuf : &ctx->fb_state.cbufs[i];
+      if ((i < PIPE_MAX_COLOR_BUFS && i >= ctx->fb_state.nr_cbufs) || !surf->texture)
+         continue;
+      struct zink_resource *res = zink_resource(surf->texture);
+      mesa_logi("WSX_LINEAR_ATTACHMENT: context=%p role=%s index=%u image=%llx format=%u extent=%ux%u samples=%u linear=%u modifier=%llx usage=%llx layout=%u",
+                (void *)ctx, i == PIPE_MAX_COLOR_BUFS ? "depth-stencil" : "color", i,
+                (unsigned long long)(uintptr_t)res->obj->image,
+                zink_get_format(screen, surf->format), res->base.b.width0,
+                res->base.b.height0, surf->nr_samples, res->linear,
+                (unsigned long long)res->obj->modifier,
+                (unsigned long long)res->obj->vkusage, res->layout);
+   }
