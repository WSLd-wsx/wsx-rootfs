+VkDeviceMemory
+wsi_common_get_acquire_memory(VkSwapchainKHR _swapchain, uint32_t index)
+{
+   VK_FROM_HANDLE(wsi_swapchain, swapchain, _swapchain);
+   assert(index < swapchain->image_count);
+   struct wsi_image *image = swapchain->get_wsi_image(swapchain, index);
+   if (swapchain->image_info.wsi.wsx_x11_linear)
+      return image->blit.memory;
+   return image->memory;
+}
